# Environment variables template
# Copy this to .env and fill with actual values

# API Configuration
DEBUG=True
WORKERS=4

# Database
DATABASE_URL=postgresql://sentinel:sentinel_secure_pwd_2024@localhost:5432/sentinel_db
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AI/ML
YOLO_MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Detection Rules
LOITERING_THRESHOLD_SECONDS=600
ABANDONED_OBJECT_THRESHOLD_SECONDS=300
CROWD_SURGE_THRESHOLD=10

# Inference
INFERENCE_BATCH_SIZE=4
INFERENCE_TIMEOUT_MS=50
GPU_ENABLED=True

# Logging
LOG_LEVEL=INFO

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
